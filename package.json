{
  "name": "bugcapsule",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gen:schemas": "tsx scripts/generate-json-schema.ts",
    "check:schemas": "tsx scripts/generate-json-schema.ts --check"
  },
  "devDependencies": {
    "@bugcapsule/format": "workspace:*",
    "@types/node": "24.13.4",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "5.0.0"
  }
}
