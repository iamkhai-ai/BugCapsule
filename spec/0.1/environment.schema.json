{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "browser": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": true
    },
    "os": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": true
    },
    "viewport": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "height": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "devicePixelRatio": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "width",
        "height",
        "devicePixelRatio"
      ],
      "additionalProperties": true
    },
    "locale": {
      "type": "string"
    },
    "timezone": {
      "type": "string"
    },
    "network": {
      "type": "object",
      "properties": {
        "online": {
          "type": "boolean"
        }
      },
      "required": [
        "online"
      ],
      "additionalProperties": true
    },
    "document": {
      "type": "object",
      "properties": {
        "visibilityState": {
          "type": "string"
        }
      },
      "required": [
        "visibilityState"
      ],
      "additionalProperties": true
    },
    "build": {
      "type": "string"
    }
  },
  "required": [
    "browser",
    "os",
    "viewport"
  ],
  "additionalProperties": true
}
